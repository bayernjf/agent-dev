# Environment contract for Agent-Dev.
#
# This file lists every variable the repository reads from the process environment.
# Copy it to `.env` (ignored by Git) and fill only what you actually use. Never commit real
# credential values; secret values live in the provider credential file or the secret backend,
# not in this template.

# ---------------------------------------------------------------------------------------------
# Daemon runtime (apps/daemon)
# ---------------------------------------------------------------------------------------------

# HTTP port for the daemon. Default: 3737.
# The listener is pinned to 127.0.0.1 by design (docs/audit-2026-08-31.md S1); this variable
# changes the port, not the bind address.
AGENT_DEV_PORT=3737

# SQLite database file for projects, delivery state and blueprints.
# Default: <repository root>/.agent-dev/agent-dev.sqlite
AGENT_DEV_DATABASE_PATH=

# File holding the daemon bearer token. Created on first start with mode 0600.
# Default: ~/.agent-dev/daemon-token
AGENT_DEV_DAEMON_TOKEN_PATH=

# Provider credential backend: `local-file` (default) or `infisical`.
# With `infisical`, startup fails loudly when the backend is unreachable instead of serving
# empty credentials.
AGENT_DEV_SECRET_BACKEND=local-file

# Provider credential file used by the `local-file` backend. Holds real secrets; never commit it.
# Default: ~/.agent-dev/credentials.txt
AGENT_DEV_CREDENTIALS_PATH=

# ---------------------------------------------------------------------------------------------
# Infisical secret backend (only when AGENT_DEV_SECRET_BACKEND=infisical)
# ---------------------------------------------------------------------------------------------

# Infisical project identifier.
INFISICAL_PROJECT_ID=

# Infisical environment slug. Default: dev
INFISICAL_ENVIRONMENT=dev

# Optional Infisical workspace identifier.
INFISICAL_WORKSPACE=

# Infisical API base URL. Default: https://us.infisical.com
INFISICAL_API_URL=

# Infisical service token. Secret: leave empty here and inject it from a secret store.
INFISICAL_SERVICE_TOKEN=

# ---------------------------------------------------------------------------------------------
# CLI and MCP bridge (apps/cli) — client side, normally on the same machine as the daemon
# ---------------------------------------------------------------------------------------------

# Daemon base URL used by `agent-dev mcp` and CLI commands. Default: http://127.0.0.1:3737
AGENT_DEV_DAEMON_URL=http://127.0.0.1:3737

# Daemon bearer token override. Secret: prefer the token file above so the value never lands in
# shell history or process listings. Leave empty here.
AGENT_DEV_DAEMON_TOKEN=

# ---------------------------------------------------------------------------------------------
# Deployment composer (packages/deployment-composer)
# ---------------------------------------------------------------------------------------------

# Vercel token used when releasing to Vercel. Secret: leave empty here and use `vercel login`
# or a secret store.
VERCEL_TOKEN=

# ---------------------------------------------------------------------------------------------
# Diagnostics and agent runtime (packages/agent-runtime)
# ---------------------------------------------------------------------------------------------

# Outbound proxy for the doctor check and the sanitised child-process environment.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

# Reported by `npm run doctor`; Node's own proxy support is opt-in.
NODE_USE_ENV_PROXY=

# OpenCode adapter driver: executable name/path. Default: opencode
OPENCODE_BIN=

# Driver polling interval in milliseconds. Default: 4000
OPENCODE_POLL_INTERVAL_MS=

# Driver run timeout in milliseconds. Default: 900000
OPENCODE_TIMEOUT_MS=

# When set to any non-empty value, the driver writes a JSON debug journal of the message stream
# into the workspace `.agent-dev/` directory. Leave empty outside debugging.
OPENCODE_DRIVER_LOG=
